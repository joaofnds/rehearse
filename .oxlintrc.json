		"no-plusplus": "error",
		"no-promise-executor-return": "error",
		"no-proto": "error",
		"no-prototype-builtins": "error",
		"no-redeclare": "error",
		"no-regex-spaces": "error",
		"no-restricted-globals": "error",
		"no-restricted-imports": [
			"error",
			{
				"paths": [
					{
						"name": "cn",
						"message": "Import cn from #client/system/cn, which knows the theme's type steps. The bare package reads them as colours and drops the variant's text colour."
					}
				]
			}
